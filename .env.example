# 复制为 .env 后按需修改；.env 不入库
DATABASE_URL=postgresql+asyncpg://crm:crm_secret@localhost:5432/crm_agent
JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRE_MINUTES=720

# LLM 供应商：openai | dashscope（均走 OpenAI 兼容协议，换供应商只改这里）
LLM_PROVIDER=openai
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.openai.com/v1
LLM_CHAT_MODEL=gpt-4o-mini
LLM_EMBED_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# 检索与切片
RETRIEVAL_TOP_K=5
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# 种子账号（首次启动自动创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
EMPLOYEE_USERNAME=employee
EMPLOYEE_PASSWORD=employee123
